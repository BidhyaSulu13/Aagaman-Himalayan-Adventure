# Environment Configuration Example
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/himalayan_adventure
JWT_SECRET=
COOKIE_SECRET=
NODE_ENV=development

# Use the same Google OAuth web client ID in client/.env.
GOOGLE_CLIENT_ID=

# Use a unique password of at least 16 characters for the administrator account.
ADMIN_EMAIL=admin@agaaman.com
ADMIN_PASSWORD=
ADMIN_NAME=Agaaman Administrator

# Required only when explicitly resetting and reseeding the database.
SEED_ADMIN_PASSWORD=
SEED_TRAVELER_PASSWORD=

# Gmail SMTP notifications. Set SMTP_USER and either the OAuth values below
# (recommended) or an App Password in SMTP_PASSWORD. Never use your Gmail login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=finalyearprj534@gmail.com
SMTP_FROM="Agaaman Himalayan Adventure <finalyearprj534@gmail.com>"
SMTP_PASSWORD=
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
SMTP_OAUTH_REFRESH_TOKEN=
