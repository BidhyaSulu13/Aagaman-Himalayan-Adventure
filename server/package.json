{
  "name": "himalayan-adventure-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:check": "node scripts/checkDatabaseConnection.js",
    "seed": "node src/seed.js",
    "catalog:add-destinations": "node scripts/addDestinationsAndRegions.js",
    "catalog:extend-trails": "node scripts/extendTrailCatalog.js",
    "treks:generate-route-maps": "node scripts/generateTrekRouteMaps.js",
    "departures:create-two-per-trek": "node scripts/createTwoDeparturesPerTrek.js",
    "departures:sync-end-dates": "node scripts/syncDepartureEndDates.js",
    "email:verify": "node scripts/verifyEmail.js",
    "admin:create": "node scripts/provisionAdmin.js",
    "journal:migrate-categories": "node scripts/migrateJournalCategories.js",
    "journal:seed-field-articles": "node scripts/seedFieldArticles.js",
    "journal:import-reviewed-experiences": "node scripts/importReviewedTrekExperiences.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "google-auth-library": "^11.3.3",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.11.4",
    "multer": "^2.5.0",
    "nodemailer": "10.3.0"
  }
}
